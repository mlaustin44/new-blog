---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.svelte';
import { site } from '../site';
import { KINDS, KIND_IDS, getEntries, toRow } from '../lib/entries';

// How many rows each group shows before "All N".
const PREVIEW = { work: 3, writing: 5, projects: 3 };

const groups = await Promise.all(
  KIND_IDS.map(async (id) => {
    const rows = (await getEntries(id)).map(toRow);
    return {
      id,
      label: KINDS[id].label,
      href: `/${id}/`,
      total: rows.length,
      preview: PREVIEW[id],
      rows,
    };
  }),
);
---

<Base>
  <section class="hero">
    <h1>{site.headline}</h1>
    <p>{site.intro}</p>
    <ul>
      {site.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </section>
  <Catalog client:load groups={groups} />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 5.5rem 5rem;
  }

  h1 {
    margin: 0;
    max-width: 47.5rem;
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.125rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
  }

  p {
    margin: 0;
    max-width: 35rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.96875rem;
    font-weight: 500;
  }

  li a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 40rem) {
    .hero {
      padding-block: 3rem 2.5rem;
    }
  }
</style>
