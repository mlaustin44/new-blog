---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.svelte';
import { getAllEntries, tagSlug, toRow, type Row } from '../../lib/entries';

export async function getStaticPaths() {
  const byTag = new Map<string, { tag: string; rows: Row[] }>();
  const entries = (await getAllEntries()).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  for (const entry of entries) {
    for (const tag of entry.data.tags) {
      const slug = tagSlug(tag);
      if (!byTag.has(slug)) byTag.set(slug, { tag, rows: [] });
      byTag.get(slug)!.rows.push(toRow(entry));
    }
  }
  return [...byTag].map(([slug, props]) => ({ params: { tag: slug }, props }));
}

interface Props {
  tag: string;
  rows: Row[];
}

const { tag, rows } = Astro.props;
const count = rows.length === 1 ? '1 entry' : `${rows.length} entries`;
---

<Base title={`Subject: ${tag}`} description={`Everything filed under ${tag}.`}>
  <header class="page-head">
    <p class="label">Subject</p>
    <h1>{tag}</h1>
    <p>{count}, across work, writing and projects.</p>
  </header>
  <div class="list">
    <EntryList rows={rows} summaries />
  </div>
</Base>

<style>
  .list {
    padding-bottom: 5.5rem;
    border-top: 2px solid var(--ink);
  }
</style>
